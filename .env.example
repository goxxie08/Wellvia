# Database Engine Selection: 'sqlite' or 'mysql'
DB_ENGINE=sqlite

# Secret Key
SECRET_KEY=wellvia-secret-key-change-in-production-2026

# MySQL Configuration (if DB_ENGINE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=wellness_db

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=1
